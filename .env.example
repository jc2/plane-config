# Plane Configuration — copy to .env and fill in actual values

# Binding (default: localhost only. Set to Tailscale IP for remote access)
# BIND_HOST=100.x.x.x  (your Tailscale IP from `tailscale ip -4`)
# BIND_HOST=0.0.0.0    (expose on all interfaces — ONLY for development)

# Database
DB_PASSWORD=your_secure_postgres_password_here

# Django (DEBUG: 0 or 1, not True/False)
DEBUG=0
SECRET_KEY=your_django_secret_key_here_min_50_chars_long
ALLOWED_HOSTS=localhost,127.0.0.1,nodo1.tayra-manta.ts.net

# CORS (for frontend to reach backend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://nodo1.tayra-manta.ts.net:3000
