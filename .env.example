# Plane — environment template.
#
# These values are set as STACK ENVIRONMENT VARIABLES in Portainer, never
# committed. This file only documents which ones exist and what they mean.
#
# Generate each secret separately (do not reuse one value across all of them):
#   python3 -c "import secrets; print(secrets.token_urlsafe(36))"

# ---------------------------------------------------------------- deployment
# Release tag. Never use `latest` — on Docker Hub that tag is ~2 years stale.
APP_RELEASE=v1.3.1

# Where the proxy binds. Default in the compose is 127.0.0.1; set it to the
# node's Tailscale IP so the board is reachable from the tailnet and nowhere
# else. `tailscale ip -4` on nodo1 gives this.
BIND_HOST=100.115.28.75
PUBLISHED_PORT=3000

# ------------------------------------------------------------------ database
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=change_me
# Must match POSTGRES_USER / POSTGRES_PASSWORD above. Host is the service name.
DATABASE_URL=postgresql://plane:change_me@plane-db/plane

# ------------------------------------------------------------------ RabbitMQ
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=plane
# Must match RABBITMQ_USER / RABBITMQ_PASSWORD / RABBITMQ_VHOST above.
AMQP_URL=amqp://plane:change_me@plane-mq:5672/plane

# ------------------------------------------- MinIO (S3 storage, internal only)
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_S3_BUCKET_NAME=uploads

# ----------------------------------------------------------------- app config
DEBUG=0
SECRET_KEY=change_me
LIVE_SERVER_SECRET_KEY=change_me

# Public address of the board — how a browser reaches it. Must match
# BIND_HOST:PUBLISHED_PORT.
WEB_URL=http://100.115.28.75:3000
CORS_ALLOWED_ORIGINS=http://100.115.28.75:3000
APP_DOMAIN=100.115.28.75:3000
